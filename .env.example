# =================================================================
# AURA LUXE — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# =================================================================

# --- SUPABASE (Required for full backend functionality) ---
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- GEMINI AI (Required for AI features) ---
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# --- APP CONFIG ---
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=AURA LUXE
VITE_FREE_SHIPPING_THRESHOLD=200
VITE_TAX_RATE=0.08

# --- EMAIL (Optional - for transactional emails via Supabase Edge Functions) ---
# VITE_RESEND_API_KEY=your-resend-key-here

# --- STRIPE (Optional - for Stripe payments) ---
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
